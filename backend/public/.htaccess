# The web app (React build, copied here by deploy/package.sh as app.html + assets/)
# and the API live on the same domain. "/" is the public website (made by Laravel); the app starts at /dashboard.
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
    # HTTPS only, for 2 years (sent only over HTTPS; the browser then never uses plain HTTP for this site).
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # Files in assets/ have a hash in their name: cache them for a year. Other files keep their name when they
    # change (staff-guide pictures in guide/, icons), so they are not cached for a year.
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # The app page and the offline copy (service worker): never cached, or staff keep an old version.
    <FilesMatch "^(app\.html|sw\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # The app page: scripts only from this site (+ the one inline theme script, by its hash), no plugins, no framing.
    # The hash must match the <script> in frontend/index.html (deploy/check-csp.sh checks it in CI).
    <FilesMatch "^app\.html$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-z/AEeak/K/SDD4clgB/AxZmh9ukx5WqWeS32LG/Ze8M='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src blob:; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    </FilesMatch>
    # Uploaded files (logos): shown as pictures only, never run as a page.
    <If "%{REQUEST_URI} =~ m#^/storage/#">
        Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
    </If>
</IfModule>

# Smaller downloads: compress text answers (pages, scripts, styles and the API's JSON).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=308]

    # API, sign-in cookie and health check: Laravel.
    RewriteCond %{REQUEST_URI} ^/(api|sanctum|up)(/|$)
    RewriteRule ^ index.php [L]

    # The public website: home page, terms, privacy, robots.txt and sitemap (Laravel, no cookies).
    RewriteCond %{REQUEST_URI} ^/(terms|privacy|robots\.txt|sitemap\.xml)?$
    RewriteRule ^ index.php [L]

    # Any other page of the web app (e.g. /reservations/12): the React app, when it is installed.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/app.html -f
    RewriteRule ^ app.html [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
