# Copy to .env on the server, then: php artisan key:generate (ONCE – never change APP_KEY later:
# guest ID numbers, two-step secrets and backups depend on it. Keep a copy somewhere safe.)
APP_NAME=HotelMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.et
FRONTEND_URL=https://app.example.et

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotelms
DB_USERNAME=hotelms
DB_PASSWORD=

# Shared hosting: database for everything (no Redis needed). On a VPS you may switch to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=app.example.et
SANCTUM_STATEFUL_DOMAINS=app.example.et
CACHE_STORE=database
# Rate-limit counters (fast in files; redis when you have Redis).
CACHE_LIMITER=file
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.et
# A mail server inside the server's own network may be set in Super Admin only when this is true.
MAIL_ALLOW_PRIVATE_HOST=false
MAIL_FROM_NAME="${APP_NAME}"

SUPER_ADMIN_EMAIL=owner@example.et
SUPER_ADMIN_PASSWORD=
HOTELMS_TWO_FACTOR_ADMINS=true
# Only behind a proxy or CDN (e.g. Cloudflare): its addresses, comma separated (or * if the server is reachable only through it).
# Empty = trust nobody (keep it empty when the web server talks to PHP directly).
TRUSTED_PROXIES=

# Backups: keep outside public_html. BACKUP_COPY_PATH = a second disk/location (Ethiopia).
BACKUP_PATH=/home/USER/hotelms-backups
BACKUP_COPY_PATH=
BACKUP_KEEP_DAYS=30
# Backups are encrypted with this key (php artisan hotelms:backup-key). Keep a copy in your password manager:
# without it the backups cannot be opened. A live server makes no backup while it is empty.
BACKUP_KEY=
